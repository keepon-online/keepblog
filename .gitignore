.idea
*.exe
*.db
logs
site
site.db
test.db
go-site
bin/
.zcode/

# 真实运行配置含密钥，不入库（模板见 config-example.yaml）
config.yaml

# IP 归属库运行时产物（由 Release 下载更新，见 docs/ipdb.md）
data/ip2region.xdb
data/*.tmp

# 换库/升级前的本地数据库备份，含生产数据，绝不入库
data/*.bak-*

# 本地 AI 工具配置
.zcodeignore

# 前端（frontend）：依赖与构建产物不提交
# static/console 的构建产物会提交，以保证 go build 时 embed 文件存在
frontend/node_modules/
frontend/dist/
frontend/.eslintcache
# Zed 编辑器项目配置
.zed
